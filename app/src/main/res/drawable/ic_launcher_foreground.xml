<?xml version="1.0" encoding="utf-8"?>
<!--
  Brand glyph: a white winding route (road) on a grass-green background, plus a
  nav-pennant icon in the top right — a pointed flag/triangle split down the
  middle into a wider white half and a narrower red half, apex up, with a
  small dark dot marking its bottom-left tip (no background circle behind it).
  Both the route and the pennant sit within the adaptive icon's ~66dp-diameter
  safe circle (centered at 54,54, radius 33) so neither gets clipped by a
  circular/squircle launcher mask.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Road: a winding line, no end marker. -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M30,78 C30,60 48,66 54,54 C60,42 42,36 42,30" />
    <!-- Nav pennant, top right: an apex-up dart shape with a small notch
         indented into its bottom edge (center), split symmetrically into an
         equal white half (left) and red half (right). Fills and the stroke
         are drawn as separate paths so the outer border and the center
         split line don't overlap and double up — both stay the same thin
         width. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M73,23 L63,49 L73,45 Z" />
    <path
        android:fillColor="#D32F2F"
        android:pathData="M73,23 L73,45 L83,49 Z" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#1A1A1A"
        android:strokeWidth="0.4"
        android:pathData="M73,23 L63,49 L73,45 L83,49 Z" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#1A1A1A"
        android:strokeWidth="0.4"
        android:pathData="M73,23 L73,45" />
</vector>
