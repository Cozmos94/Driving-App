<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed to fetch vector tiles from the free tile source. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Location permissions are declared ahead of step 6 (record-the-drive) but not
      requested anywhere yet — step 1 only renders a map, no location code runs.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!--
      Package-visibility declarations (required on API 30+) so
      Intent#resolveActivity() in openInNavApp() (RouteDetailScreen.kt) can actually
      see Google Maps / a geo: handler — without these, resolveActivity() silently
      returns null even when a matching app is installed, and the "Open in nav app"
      button does nothing.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="google.navigation" />
        </intent>
        <!-- Fallback path in openInNavApp() when Maps isn't installed: a plain
             https Google Maps directions URL, opened by whatever browser/app
             handles it. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <package android:name="com.google.android.apps.maps" />
    </queries>

    <application
        android:name=".LessonRoutesApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.LessonRoutes">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.LessonRoutes.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
